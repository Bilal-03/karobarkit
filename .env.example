# Local development default. Set this to the single canonical HTTPS production URL in production.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Contact form delivery (server-only; add these in Vercel Project Settings, not in client code).
RESEND_API_KEY=
CONTACT_TO_EMAIL=
# Until a sending domain is verified, Resend allows testing from onboarding@resend.dev to your own account email.
CONTACT_FROM_EMAIL=KarobarKit <onboarding@resend.dev>

# Phase 6 AI assistants (server-only; never use NEXT_PUBLIC_ for these keys).
# Set AI_PROVIDER to gemini, groq or auto. With no key, assistants use deterministic drafts.
AI_PROVIDER=auto
# Use a server-only Google AI Studio auth/restricted key; never expose it with NEXT_PUBLIC_.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b

# Optional shared atomic rate-limit service for multi-instance deployments.
# Without these values the bounded in-process limiter is used for local/public beta operation.
AI_RATE_LIMIT_SHARED_ENDPOINT=
AI_RATE_LIMIT_SHARED_TOKEN=
# Per-instance safety ceiling; enforce the same budget in the shared counter for multi-instance deployments.
AI_PROVIDER_DAILY_REQUEST_LIMIT=250
